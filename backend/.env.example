# Copy this file to .env and fill in real values. Never commit .env.

# Environment: development | production
APP_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# SQLite database file path (relative to backend/)
DATABASE_PATH=data/echoward.db

# Gemini API key (https://aistudio.google.com/apikey) - used by the M2 incident-
# intelligence extraction service (app/llm.py, app/intelligence.py) to turn
# conversation turns into structured facts/hypotheses/decisions/actions/etc.
# NOT used by the Agora voice agent itself, which uses Agora-managed LLM/ASR/TTS
# credentials instead (see AGORA_LLM_* below) - these are two separate LLM calls
# for two separate purposes. Without this set, POST .../conversation returns 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Agora App credentials (console.agora.io > your project) ---
# App ID is also used by the browser (via NEXT_PUBLIC_AGORA_APP_ID in the frontend).
# App Certificate must NEVER be sent to the browser - server-side only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Agora RESTful API credentials (console.agora.io > project > RESTful API) ---
# Separate from the App ID/Certificate above. Used for Basic auth when the backend
# calls the Conversational AI Engine REST API to start/stop the EchoWard agent.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Base URL for the Agora Conversational AI Engine REST API (rarely needs changing).
AGORA_CONVO_AI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2/projects

# Seconds an issued RTC token / agent join token remains valid.
AGORA_TOKEN_EXPIRE_SECONDS=3600

# Fixed RTC uid the EchoWard agent uses when it joins a channel.
AGORA_AGENT_UID=9999

# --- Agora-managed ASR/LLM/TTS preset for the EchoWard voice agent ---
# credential_mode=managed is used in code, so Agora bills/authenticates these
# vendors on your behalf - no separate Deepgram/OpenAI/MiniMax API keys needed.
# Change these only if your Agora project's managed-preset catalog differs.
AGORA_ASR_VENDOR=deepgram
AGORA_ASR_MODEL=nova-3
AGORA_ASR_LANGUAGE=en-US
AGORA_LLM_VENDOR=openai
AGORA_LLM_MODEL=gpt-4o-mini
AGORA_TTS_VENDOR=minimax
AGORA_TTS_MODEL=speech-2.6-turbo
AGORA_TTS_VOICE_ID=English_captivating_female1
